RewriteEngine on
RewriteRule ^home index.php [NC,L]

RedirectMatch permanent ^/home/((css|js)/.*)  /$1
Rewritecond %{REQUEST_FILENAME} !-d
Rewritecond %{REQUEST_FILENAME} !-f
Rewritecond %{REQUEST_FILENAME} !-1


RewriteRule ^(products)/([0-9a-zA-Z_-]+)/([0-9a-zA-Z_-]+) search.php?cat=$2&subCat=$3 [QSA,L]
RewriteRule ^(products)/([0-9a-zA-Z_-]+) search.php?cat=$2 [QSA,L]
#RewriteRule ^(.*) search.php?cat=$1&subCat=$2 [QSA,L]
RewriteRule ^product/([0-9a-zA-Z_-]+) product.php?url=$1 [NC,L]

#RewriteRule ^(.*) search.php?cat=$1 [QSA,L]




# Commented out for localhost development - uncomment for production with SSL
#RewriteCond %{HTTPS} !on
#RewriteRule (.*) https://%{HTTP_HOST}%{REQUEST_URI}

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php74” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php74 .php .php7 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
