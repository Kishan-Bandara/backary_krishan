            <?php if (!empty($message)) { ?>
                <div class="alert <?php echo ($type === 'error') ? 'alert-danger' : 'alert-success'; ?> alert-dismissable">
                    <button type="button" class="close" data-dismiss="alert" aria-hidden="true"></button>
                    <?php echo htmlspecialchars($message); ?>
                </div>
            <?php } ?>
            <h3 class="page-title">Purchase Note Details</h3>

            <div class="row">
                <div class="col-md-12">
                    <div class="portlet light bordered">
                        <div class="portlet-title">
                            <div class="actions">
                                <?php if ($note['status'] !== 'COMPLETED') { ?>
                                    <a href="grn-create.php?purchase_note_id=<?php echo $purchaseNoteId; ?>" class="btn btn-sm green">Create GRN</a>
                                <?php } ?>
                                <a href="purchase-order-list.php" class="btn btn-sm default">Back to List</a>
                            </div>
                        </div>
                        <div class="portlet-body">
                            <div class="row">
                                <div class="col-md-4"><strong>Purchase Note Code:</strong> <?php echo $note['purchase_note_code']; ?></div>
                                <div class="col-md-4"><strong>Date:</strong> <?php echo $note['purchase_date']; ?></div>
                                <div class="col-md-4"><strong>Status:</strong> <?php echo $note['status']; ?></div>
                            </div>
                            <div class="row" style="margin-top: 10px;">
                                <div class="col-md-4"><strong>Supplier:</strong> <?php echo $supplier['supplier_name'] ?? ''; ?></div>
                                <div class="col-md-4"><strong>Supplier Phone:</strong> <?php echo $supplier['supplier_contact_no'] ?? ''; ?></div>
                                <div class="col-md-4"><strong>Location:</strong> <?php echo $location['name'] ?? ''; ?></div>
                            </div>
                        </div>
                    </div>

                    <div class="portlet light bordered">
                        <div class="portlet-title">
                            <div class="caption">Items</div>
                        </div>
                        <div class="portlet-body">
                            <table class="table table-bordered">
                                <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Requested Qty</th>
                                    <th>Total Received Qty</th>
                                    <th>Balance Qty</th>
                                </tr>
                                </thead>
                                <tbody>
                                <?php foreach ($items as $item) { ?>
                                    <tr>
                                        <td><?php echo $item['item_name']; ?></td>
                                        <td><?php echo $item['requested_qty']; ?></td>
                                        <td><?php echo $item['total_received_qty']; ?></td>
                                        <td><?php echo $item['balance_qty']; ?></td>
                                    </tr>
                                <?php } ?>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="portlet light bordered">
                        <div class="portlet-title">
                            <div class="caption">Related GRNs</div>
                        </div>
                        <div class="portlet-body">
                            <table class="table table-bordered">
                                <thead>
                                <tr>
                                    <th>GRN Code</th>
                                    <th>GRN Date</th>
                                    <th>View</th>
                                </tr>
                                </thead>
                                <tbody>
                                <?php if (count($grns) === 0) { ?>
                                    <tr>
                                        <td colspan="3">No GRNs created yet.</td>
                                    </tr>
                                <?php } else { ?>
                                    <?php foreach ($grns as $grn) { ?>
                                        <tr>
                                            <td><?php echo $grn['grn_h_code']; ?></td>
                                            <td><?php echo $grn['grn_h_date']; ?></td>
                                            <td><a href="purchase_note.php?id=<?php echo $grn['grn_h_id']; ?>" class="btn btn-xs btn-default"><i class="fa fa-eye"></i></a></td>
                                        </tr>
                                    <?php } ?>
                                <?php } ?>
                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>
