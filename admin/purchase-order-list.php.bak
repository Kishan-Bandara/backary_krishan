                                <?php foreach (getPurchaseNotes() as $note) {
                                    $status = $note['status'];
                                    $statusClass = 'label-default';
                                    if ($status === 'OPEN') {
                                        $statusClass = 'label-warning';
                                    } elseif ($status === 'PARTIALLY_RECEIVED') {
                                        $statusClass = 'label-info';
                                    } elseif ($status === 'COMPLETED') {
                                        $statusClass = 'label-success';
                                    }
                                    ?>
                                    <tr>
                                        <td><?php echo $note['purchase_note_code']; ?></td>
                                        <td><?php echo getSupplierName($note['supplier_id']); ?></td>
                                        <td><?php echo $note['purchase_date']; ?></td>
                                        <td><span class="label <?php echo $statusClass; ?>"><?php echo $status; ?></span></td>
                                        <td><?php echo getUserName($note['created_by']); ?></td>
                                        <td>
                                            <a href="purchase-order-view.php?id=<?php echo $note['purchase_note_id']; ?>" class="btn btn-xs btn-default" title="View">
                                                <i class="fa fa-eye"></i>
                                            </a>
                                            <?php if ($status !== 'COMPLETED') { ?>
                                                <a href="grn-create.php?purchase_note_id=<?php echo $note['purchase_note_id']; ?>" class="btn btn-xs btn-success" title="Create GRN">
                                                    <i class="fa fa-plus"></i>
                                                </a>
                                            <?php } else { ?>
                                                <span class="btn btn-xs btn-default disabled" title="Completed">
